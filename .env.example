# Copy to .env and adjust. Nothing here is a secret; local services only.
ONSIDE_ENV=local
ONSIDE_TABLE=onside
ONSIDE_DYNAMO_ENDPOINT=http://localhost:8000
ONSIDE_REDIS_URL=redis://localhost:6379/0
ONSIDE_ARCHIVE_URI=data/archive/events
ONSIDE_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=onside
AWS_SECRET_ACCESS_KEY=onside-local-only
AWS_DEFAULT_REGION=us-east-1

# ---------------------------------------------------------------------------
# Outside feeds. Put real values in a file called .env next to
# docker-compose.yml (never in this file - this one is committed).

# football-data.org: current fixtures, tables, scorers.
# Free key at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
# API-Football: implemented and contract-tested, deliberately not enabled.
API_FOOTBALL_KEY=

# Social feed. Mastodon needs nothing.
# Bluesky: Settings -> Privacy and security -> App passwords (read-only is enough)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Reddit: an approved "script" app from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# X: pay-per-use (~$0.005 per post read). Both must be set to switch it on.
X_BEARER_TOKEN=
X_MAX_READS_PER_DAY=0
