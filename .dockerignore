# Only the Parquet archive, which the Lambda image carries (Dockerfile, target
# lambda). Raw downloads and built documents never enter a build.
data/*
!data/archive
**/node_modules
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
frontend/dist
.git
demo/index.html
# Secrets stay out of every image (and so out of ECR).
.env
.env.*
!.env.example
infra/cdk.out
